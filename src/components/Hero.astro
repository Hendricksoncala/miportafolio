---
const personalImageAlt = "Hendrickson Ruiz"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"

// Eliminamos el import de arriba y usamos la ruta directa en el HTML
const cvPath = "/HendricksonAlexanderRuizCala.pdf"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16 object-cover"
      src="/me.png"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/HendricksonCala"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, soy Hendrickson
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-[#ebcda2] [&>strong]:text-yellow-600 [&>strong]:font-semibold dark:text-gray-300 text-pretty"
  >
    <strong>Data Analyst y Desarrollador de Software</strong> de Bucaramanga, Santander. Apasionado por la ingeniería de datos, las arquitecturas cloud y la creación de soluciones tecnológicas de alto impacto.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:hendricksoncala@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/HendricksonCala">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href={cvPath} download="HendricksonAlexanderRuizCala.pdf">
      <MailIcon class="size-4" />
      Hoja de Vida
    </SocialPill>
  </nav>
</div>